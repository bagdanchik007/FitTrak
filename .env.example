# Application
APP_NAME=FitTrack
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
# SECRET_KEY must be at least 32 characters
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack_secret
POSTGRES_DB=fittrack
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fittrack:fittrack_secret@db:5432/fittrack

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO

# Optional multi-instance live sessions
# REDIS_URL=redis://localhost:6379/0

# Optional real email (leave empty = log-only in development)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@fittrack.local
# SMTP_TLS=true

# Optional AI coach (leave empty for rule engine)
# OPENAI_API_KEY=
